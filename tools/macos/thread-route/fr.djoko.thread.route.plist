<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- thread-route : garde la route du reseau Thread (voir README.md). Installe par installer.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>fr.djoko.thread.route</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/fr.djoko.thread.route</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Library/Logs/fr.djoko.thread.route.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/fr.djoko.thread.route.log</string>
</dict>
</plist>
